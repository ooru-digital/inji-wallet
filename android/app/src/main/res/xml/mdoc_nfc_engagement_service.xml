<?xml version="1.0" encoding="utf-8"?>
<!-- NFC engagement for ISO/IEC 18013-5: the reader selects the NFC Forum Type 4 Tag application
     and reads our handover from it. Only with the phone unlocked, so a locked phone in a pocket
     answers no reader. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/mdoc_nfc_aid_group"
    android:requireDeviceUnlock="true"
    android:requireDeviceScreenOn="true">
    <aid-group android:description="@string/mdoc_nfc_aid_group" android:category="other">
        <aid-filter android:name="D2760000850101" />
    </aid-group>
</host-apdu-service>

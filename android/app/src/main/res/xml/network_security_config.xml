<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- SnapKYC face-liveness endpoints are plain HTTP; everything else stays TLS-only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">biochq.credissuer.com</domain>
        <domain includeSubdomains="true">demo-ooru.psnb.de</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

+
+extension UIImage {
+    /// `.cgImage` is the raw, unrotated pixel buffer — it carries no orientation of its own.
+    /// `UIImage.imageOrientation` (parsed from the source JPEG's EXIF tag) is only ever applied
+    /// when this UIImage itself is *drawn* (UIImageView, draw(in:), etc.); every call site above
+    /// hands `.cgImage` straight to the face SDK's native encoder/liveness model, bypassing that
+    /// entirely. A front-camera capture routinely comes back with a non-.up EXIF orientation (the
+    /// pixels aren't physically rotated on capture, just tagged), so the model was receiving a
+    /// sideways/mirrored buffer even though the exact same UIImage displays correctly everywhere
+    /// else in the app — the face is misaligned for detection/encoding, not merely "not a match".
+    /// Redrawing into a fresh bitmap context bakes `imageOrientation` into the actual pixels, so
+    /// the CGImage handed to the model matches what a person looking at the photo would see.
+    func normalizedForFaceSdk() -> UIImage {
+        if imageOrientation == .up {
+            return self
+        }
+        let renderer = UIGraphicsImageRenderer(size: size)
+        return renderer.image { _ in
+            draw(in: CGRect(origin: .zero, size: size))
+        }
+    }
+}
